# Backend env template — copy to .env and fill values.
# Loaded by Node itself (`node --env-file-if-exists=.env`), no dotenv package.
# Atlas: org project "personal-projects" -> Cluster0 (free tier, Mumbai). Mongoose creates the collections on first save.
# A free cluster is PAUSED after long inactivity; its hostname then stops resolving
# ("querySrv ENOTFOUND"). Fix: Atlas -> Clusters -> Resume.

PORT=5000
NODE_ENV=development
# mongodb+srv://<user>:<password>@cluster0.t8qjzer.mongodb.net/flipone?retryWrites=true&w=majority&appName=Cluster0
# Use a user with readWrite on the "flipone" database only. URL-encode special characters in the password.
MONGO_URI=
# Long random string, e.g. node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRE=1d
# Used to build absolute profile picture URLs
BASE_URL=http://localhost:5000
# Comma-separated allowed frontend origins. Empty in development = any http://localhost:<port>.
# Required in production (empty there = no cross-origin browser access).
CORS_ORIGIN=
# Set to 1 when running behind a reverse proxy, so rate limiting sees real client IPs
TRUST_PROXY=
# Optional: error | warn | info | http | debug
LOG_LEVEL=

# ---------- Email (sign-up confirmation codes) ----------
# Leave MAIL_TRANSPORT empty in development: nothing is sent, the code is printed in this terminal and the email
# is saved as HTML in logs/mail/latest.html. Production refuses to start without a transport.
#
# gmail         Gmail with an App Password (simplest). Needs 2-Step Verification on the Google account, then
#               https://myaccount.google.com/apppasswords -> create one named "FlipOne" -> paste the 16 letters.
# gmail-oauth2  Gmail through a Google Cloud OAuth client (no password stored). Console: enable the Gmail API,
#               create an OAuth client (Web), get a refresh token with scope https://mail.google.com/ (e.g. the
#               OAuth 2.0 Playground with "Use your own OAuth credentials"). While the consent screen is in
#               "Testing", Google expires the refresh token after 7 days: publish the app to keep it.
# smtp          Any SMTP provider (Brevo, Resend, Mailtrap ...): SMTP_HOST, SMTP_PORT (465 = TLS), SMTP_USER, SMTP_PASS.
MAIL_TRANSPORT=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# What the inbox shows: "FlipOne <you@gmail.com>". Gmail only sends from GMAIL_USER, or from a "Send mail as"
# alias you verified in Gmail settings (then set MAIL_FROM_ADDRESS to it).
MAIL_FROM_NAME=FlipOne
MAIL_FROM_ADDRESS=
# Optional: where replies go (defaults to the sender)
MAIL_REPLY_TO=
