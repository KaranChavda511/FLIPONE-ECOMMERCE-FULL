{
  "name": "flipone-backend",
  "version": "1.0.0",
  "private": true,
  "description": "E-commerce backend with authentication, product management, cart & order placement and admin controls, with advanced logging.",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch-path=./src --import ./scripts/load-env.js server.js",
    "create-admin": "node --env-file-if-exists=.env scripts/createAdmin.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seedDemo.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "~10.2.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
